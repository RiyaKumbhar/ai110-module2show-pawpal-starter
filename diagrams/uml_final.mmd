classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_all_tasks() list~Task~
        +get_pending_tasks() list~Task~
        +update_preferences(prefs) void
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +list~Task~ tasks
        +add_task(task) void
        +edit_task(task_id, changes) void
        +remove_task(task_id) void
        +get_pending_tasks() list~Task~
        -_find(task_id) Task
    }

    class Task {
        +str id
        +str title
        +str category
        +int duration_minutes
        +str priority
        +time preferred_time
        +time due_time
        +date due_date
        +str pet_name
        +str frequency
        +bool completed
        +mark_complete() void
        +next_occurrence(today) Task
        +update(changes) void
        +is_high_priority() bool
    }

    class ScheduledItem {
        +Task task
        +time start_time
        +time end_time
        +str reason
        +overlaps(other) bool
        +describe() str
    }

    class DailyPlan {
        +date plan_date
        +list~ScheduledItem~ scheduled
        +list skipped
        +int total_minutes
        +add_item(item) void
        +remaining_minutes(owner) int
        +summary() str
    }

    class Scheduler {
        +Owner owner
        +time day_start
        +sort_tasks(tasks) list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed, category) list~Task~
        +detect_conflicts(items) list
        +find_time_conflicts(tasks) list~str~
        +complete_task(task) Task
        +generate_plan() DailyPlan
        +explain_choice(task) str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Task ..> Task : next_occurrence creates copy
    Scheduler --> Owner : reads tasks via get_all_tasks
    Scheduler ..> Task : sorts, filters, completes
    Scheduler ..> ScheduledItem : creates
    Scheduler ..> DailyPlan : produces
    DailyPlan "1" --> "*" ScheduledItem : contains
    ScheduledItem --> Task : schedules
